<?xml version="1.0"?>

<robot name="mockbot" xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:include filename="common_macros.urdf.xacro" />
	<xacro:property name="top_mass" value="0.2" />
	<xacro:property name="top_radius" value="0.17" />
	<xacro:property name="top_length" value="0.02" />
	<xacro:property name="leg_mass" value="0.05" />
	<xacro:property name="leg_radius" value="0.0125" />
	<xacro:property name="leg_length" value="0.3" />
	<xacro:property name="leg_x_off" value="0.077" />
	<xacro:property name="leg_y_off" value="0.077" />
	<xacro:property name="leg_z_off" value="0.175" />

  <xacro:macro name="tabletop" params="z_offset:=0" >
    <link name="top_link">
      <visual>
	<origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
		<cylinder length="${top_length}" radius="${top_radius}"/>
        </geometry>
        <material name="yellow">
          <color rgba="0.8784 0.6627 0.6627 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
	   <cylinder length="${top_length}" radius="${top_radius}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder_with_pose mass="${top_mass}" radius="${top_radius}" length="${top_length}" >
	      <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder_with_pose>
    </link>

    <joint name="top_to_base" type="fixed">
      <parent link="base_link"/>
      <child link="top_link"/>
      <origin xyz="0 0 ${(top_length / 2) + leg_length + z_offset}" rpy="0 0 0"/>
    </joint>


  <link name="left_front_leg_link">
    <visual>
        <origin xyz="-${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
       <material name="blue">
            <color rgba="0.1764 0.4588 0.8509 1.0"/>
       </material>
    </visual>
    <collision>
        <origin xyz="-${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder_with_pose mass="${leg_mass}" radius="${leg_radius}" length="${leg_length}">
	    <origin xyz="-${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder_with_pose>
  </link>

    <joint name="left_front_leg_joint" type="fixed">
      <axis xyz="0 0 1" />
      <parent link="top_link"/>
      <child link="left_front_leg_link"/>
      <origin xyz="0.0 0.0 ${-(top_length / 2)}" rpy="0 0 0"/>
  </joint>

  <link name="right_front_leg_link">
    <visual>
	<origin xyz="${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
       <material name="blue">
            <color rgba="0.1764 0.4588 0.8509 1.0"/>
       </material>
    </visual>
    <collision>
	<origin xyz="${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder_with_pose mass="${leg_mass}" radius="${leg_radius}" length="${leg_length}">
	<origin xyz="${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder_with_pose>
  </link>

    <joint name="right_front_leg_joint" type="fixed">
      <axis xyz="0 0 1" />
      <parent link="top_link"/>
      <child link="right_front_leg_link"/>
      <origin xyz="0.0 0.0 ${-(top_length / 2)}" rpy="0 0 0"/>
  </joint>

  <link name="left_rear_leg_link">
    <visual>
	<origin xyz="-${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
       <material name="blue">
            <color rgba="0.1764 0.4588 0.8509 1.0"/>
       </material>
    </visual>
    <collision>
	<origin xyz="-${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder_with_pose mass="${leg_mass}" radius="${leg_radius}" length="${leg_length}">
	<origin xyz="-${leg_x_off} -${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder_with_pose>
  </link>

    <joint name="left_rear_leg_joint" type="fixed">
      <axis xyz="0 0 1" />
      <parent link="top_link"/>
      <child link="left_rear_leg_link"/>
      <origin xyz="0.0 0.0 ${-(top_length / 2)}" rpy="0 0 0"/>
  </joint>

  <link name="right_rear_leg_link">
    <visual>
	<origin xyz="${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
       <material name="blue">
            <color rgba="0.1764 0.4588 0.8509 1.0"/>
       </material>
    </visual>
    <collision>
	<origin xyz="${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
        <geometry>
		<cylinder radius="${leg_radius}" length="${leg_length}"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder_with_pose mass="${leg_mass}" radius="${leg_radius}" length="${leg_length}">
	<origin xyz="${leg_x_off} ${leg_y_off} -${leg_length/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder_with_pose>
  </link>

    <joint name="right_rear_leg_joint" type="fixed">
      <axis xyz="0 0 1" />
      <parent link="top_link"/>
      <child link="right_rear_leg_link"/>
      <origin xyz="0.0 0.0 ${-(top_length / 2)}" rpy="0 0 0"/>
   </joint>

  </xacro:macro>
</robot>
